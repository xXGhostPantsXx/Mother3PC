+    const bool value = method ? env->CallBooleanMethod(activity, method) : fallback;
+    if (env->ExceptionCheck()) env->ExceptionClear();
+    if (cls) env->DeleteLocalRef(cls);
+    env->DeleteLocalRef(activity);
