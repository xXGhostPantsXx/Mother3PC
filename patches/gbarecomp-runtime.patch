-    auto demo_keyinput_for_frame = [](uint64_t frame) -> uint16_t {
-        enum : uint16_t {
-            KEY_A = 1u << 0, KEY_B = 1u << 1, KEY_START = 1u << 3,
-            KEY_RIGHT = 1u << 4, KEY_LEFT = 1u << 5,
-            KEY_UP = 1u << 6, KEY_DOWN = 1u << 7,
