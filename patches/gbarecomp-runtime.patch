+            s.guest_us = prev_exit_ns ? us(prev_exit_ns, t0) : 0;
+            s.render_us = us(t0, t1);
+            s.present_us = us(t1, t2);
+            s.audio_us = us(t2, t3);
+            s.pump_us = us(t3, t4);
+            s.pacer_us = us(t4, t5);
