+        return p.string();
+    };
+    auto clear_suspend_marker = [&]() {
+        std::error_code ec;
+        std::filesystem::remove(suspend_marker_path(), ec);
+    };
+    bool suspend_on_exit = false;  // OS termination keeps the marker
+
+    uint64_t last_presented_frame = ppu.frame_count();
