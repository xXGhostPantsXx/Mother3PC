-        // main-thread instruction execution differs. See COSIM_ORACLE.md §1.
-        const uint32_t step_pc = g_cpu.R[15] & ~1u;
-        const int step_thumb = (g_cpu.cpsr & CPSR_T_BIT) != 0;
