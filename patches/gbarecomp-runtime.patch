-        static const uint16_t kButtons[] = {
-            KEY_START, KEY_A, KEY_A, KEY_DOWN, KEY_A, KEY_RIGHT,
-            KEY_B, KEY_A, KEY_LEFT, KEY_A, KEY_UP, KEY_B,
