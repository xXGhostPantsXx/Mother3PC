-void find_config_arg(int argc, char** argv, Args* args) {
-    for (int i = 1; i < argc; ++i) {
-        std::string s = argv[i];
-        if (s == "--config" && i + 1 < argc) {
-            args->config = argv[++i];
-            continue;
-        }
-        if (cli_flag_takes_value(s) && i + 1 < argc) {
-            ++i;
-            continue;
-        }
-        if (!s.empty() && s[0] != '-') {
-            args->config = s;
-        }
-    }
-}
