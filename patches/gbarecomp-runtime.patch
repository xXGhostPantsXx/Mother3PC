+    auto combat_keyinput_for_frame = [](uint64_t frame) -> uint16_t {
+        enum : uint16_t {
+            KEY_A = 1u << 0, KEY_B = 1u << 1, KEY_L = 1u << 9,
+            KEY_RIGHT = 1u << 4,
